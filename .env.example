# ─── Database ────────────────────────────────────────────────────────────────
# Async URL for FastAPI / SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/complianceforge
# Sync URL for Alembic migrations and Node pg client
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/complianceforge
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=complianceforge

# ─── LLMs ────────────────────────────────────────────────────────────────────
# Groq is the primary reasoning provider (fast, generous free tier).
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=60

# ─── LangSmith (observability) ───────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=complianceforge
LANGCHAIN_TRACING_V2=true

# ─── Vector Stores ───────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

FAISS_INDEX_PATH=./backend/rag/indexes/faiss

# ─── MCP Server ──────────────────────────────────────────────────────────────
MCP_SERVER_URL=http://localhost:3000
MCP_SERVER_PORT=3000

# ─── Frontend / Auth ─────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MCP_SERVER_URL=http://localhost:3000

NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

# Email magic-link provider
EMAIL_SERVER=
EMAIL_FROM=noreply@complianceforge.local

# ─── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ─── Cost tracking ───────────────────────────────────────────────────────────
COST_ALERT_THRESHOLD_USD=10.00
